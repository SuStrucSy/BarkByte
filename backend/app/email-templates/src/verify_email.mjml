<mjml>
  <mj-head>
    <mj-title>{{ project_name }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, Helvetica, sans-serif" />
      <mj-text
        color="#52525b"
        font-size="15px"
        line-height="1.6"
      />
      <mj-button
        border-radius="8px"
        font-size="15px"
        font-weight="600"
        inner-padding="12px 24px"
      />
    </mj-attributes>
    <mj-style>
      .card {
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f5f7">

    <!-- Card wrapper — must be a direct child of mj-body -->
    <mj-wrapper
      css-class="card"
      background-color="#ffffff"
      border-radius="12px"
      padding="0"
      border="none"
    >
      <mj-section padding="40px 16px 28px">
        <mj-column width="100%">

          <!-- Logo -->
          <mj-image
            src="{{ logo_url }}"
            alt="{{ project_name }}"
            width="100px"
            align="left"
            padding-bottom="10px"
          />

          <!-- Title -->
          <mj-text
            align="center"
            font-size="20px"
            font-weight="700"
            color="#18181b"
          >
            {{ project_name }}
          </mj-text>

          <mj-divider border-color="#e4e4e7" />

          <!-- Greeting -->
          <mj-text align="center">
            Hi {{ username }},
          </mj-text>

          <!-- Message -->
          <mj-text align="center">
            Thanks for signing up for {{ project_name }}.
            Please verify your email to activate your account.
          </mj-text>

          <!-- Button -->
          <mj-button
            align="center"
            background-color="#18181b"
            color="#ffffff"
            href="{{ link }}"
          >
            {{ button_text }}
          </mj-button>

          <!-- Fallback label -->
          <mj-text align="center" font-size="13px" color="#a1a1aa">
            If the button doesn't work, copy this link:
          </mj-text>

          <!-- Fallback link -->
          <mj-text align="center" font-size="13px">
            <a href="{{ link }}" style="color:#18181b; word-break:break-all;">
              {{ link }}
            </a>
          </mj-text>

          <!-- Expiry -->
          <mj-text align="center" font-size="13px" color="#a1a1aa">
            This link expires in {{ valid_hours }} hours.
          </mj-text>

          <mj-divider border-color="#e4e4e7" />

          <!-- Footer note -->
          <mj-text align="center" font-size="12px" color="#a1a1aa">
            If you didn't request this email, you can safely ignore it.
          </mj-text>

        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Copyright below card -->
    <mj-section padding="16px 16px 40px">
      <mj-column>
        <mj-text
          align="center"
          font-size="11px"
          color="#d4d4d8"
        >
          © {{ project_name }}
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
